<?xml version="1.0" encoding="utf-8"?>
<!-- 2x1: the pet left, [도감] [뽑기] icons side by side on the right (operator 11-16: across, not stacked) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical">
    <ImageView android:id="@+id/art" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
        android:contentDescription="@string/widget_desc" android:scaleType="fitCenter" />
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginEnd="2dp">
        <ImageView android:id="@+id/btn_dex" android:layout_width="36dp" android:layout_height="36dp" android:layout_margin="3dp"
            android:background="@drawable/widget_btn_leaf" android:padding="4dp" android:src="@drawable/ic_menu_dex"
            android:contentDescription="도감" />
        <ImageView android:id="@+id/btn_catch" android:layout_width="36dp" android:layout_height="36dp" android:layout_margin="3dp"
            android:background="@drawable/widget_btn_pink" android:padding="4dp" android:src="@drawable/ic_menu_catch"
            android:contentDescription="뽑기" />
    </LinearLayout>
</LinearLayout>
