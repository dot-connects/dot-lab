[[0.2, "reel/voice/fast/00.wav", "폰을 흔들어서 볶음밥을 만들어 봐!"], [2.65, "reel/voice/fast/01.wav", "김치랑 찬밥 넣고, 박자 맞춰 볶자!"], [6.4, "reel/voice/fast/02.wav", "옆으로 흘리지 말고 잘 볶아 봐!"], [12.9, "reel/voice/fast/03.wav", "정전이 돼도 당황하지 말고~"], [15.65, "reel/voice/fast/04.wav", "마무리까지!"], [20.7, "reel/voice/fast/05.wav", "계란까지 올려 주면,"], [25.3, "reel/voice/fast/06.wav", "한 그릇 뚝딱!"], [28.5, "reel/voice2/fast/00.wav", "주방장은 구십이 점!"], [30.5, "reel/voice/fast/07.wav", "너도 한번 볶아 볼래?"]]